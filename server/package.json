{
  "name": "pokeventure-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pokéventure game server: battles on the real Pokémon Showdown engine.",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke": "node scripts/battle-smoke.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
