# Copy this file to .env and fill in your own values, then run:
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
#
# .env is git-ignored. Never commit real keys.

# The Node battle server (see docs/HOSTING.md).
# Android emulator: http://10.0.2.2:8787 · device on Wi-Fi: http://<your-ip>:8787
API_BASE_URL=http://127.0.0.1:8787

# Optional: trainer cards, QR friend invites and friend battles.
# The anon key is public by design. Use the service-role key only on a server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
